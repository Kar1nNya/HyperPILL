# Normalize line endings
* text=auto

# Source files: always LF
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.list text eol=lf
*.prop text eol=lf
*.gradle text eol=lf

# Shell scripts: LF
*.sh text eol=lf
gradlew text eol=lf

# Windows batch: CRLF
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
